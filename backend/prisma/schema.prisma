// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. Definición de Enums
enum Rol {
  ADMIN
  ENCARGADO
  SOLICITANTE
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
}

// 2. Modelo de Usuarios (Personal de la Facultad)
model Usuario {
  id              Int          @id @default(autoincrement())
  id_interno      String       @unique @db.VarChar(20)
  nombre          String       @db.VarChar(100)
  correo          String?      @db.VarChar(100)
  departamento    String       @db.VarChar(50)
  rol             Rol
  
  // Credenciales y Estado de Seguridad
  password        String?      @db.VarChar(255) 
  activo          Boolean      @default(true)   
  
  // Relaciones inversas
  solicitudes     Movimiento[] @relation("SolicitanteRel")
  registros       Movimiento[] @relation("EncargadoRel")
  auditorias      Auditoria[]  

  //  ÍNDICES DE RENDIMIENTO (Búsquedas y filtros en Paginación de Usuarios)
  @@index([nombre])
  @@index([correo])
  @@index([id_interno])
  @@index([rol])
  @@map("usuarios")
}

// 3. Modelo de Productos (Catálogo de Insumos)
model Producto {
  id            Int          @id @default(autoincrement())
  nombre        String       @db.VarChar(100)
  categoria     String       @db.VarChar(50)
  unidad_medida String       @db.VarChar(15)
  existencias   StockEdificio[]
  embalajes     Embalaje[]
  movimientos   Movimiento[]
  historial_critico HistorialStockCritico[]

  //  ÍNDICES DE RENDIMIENTO (Agiliza las búsquedas de texto en el Catálogo)
  @@index([nombre])
  @@index([categoria])
  @@map("productos")
}

// 4. Modelo de Embalajes (Conversión para compras a granel)
model Embalaje {
  id                Int      @id @default(autoincrement())
  producto_id       Int
  nombre_embalaje   String   @db.VarChar(50)
  factor_conversion Decimal  @db.Decimal(10, 2)
  
  producto          Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  //  ÍNDICE DE RENDIMIENTO (Mejora los JOINs al traer el catálogo)
  @@index([producto_id])
  @@map("embalajes")
}

// 5. Modelo de Movimientos (Bitácora Operativa Regular)
model Movimiento {
  id             Int            @id @default(autoincrement())
  producto_id    Int
  tipo           TipoMovimiento
  cantidad       Decimal        @db.Decimal(10, 2)
  edificio       String         @db.VarChar(50)         
  solicitante_id Int?
  encargado_id   Int
  fecha          DateTime       @default(now())
  observaciones  String?        @db.Text

  producto       Producto       @relation(fields: [producto_id], references: [id], onDelete: Restrict)
  solicitante    Usuario?       @relation("SolicitanteRel", fields: [solicitante_id], references: [id], onDelete: SetNull)
  encargado      Usuario        @relation("EncargadoRel", fields: [encargado_id], references: [id], onDelete: Restrict)

  //  ÍNDICES DE RENDIMIENTO (Vitales para la paginación y Dashboard Analítico)
  @@index([fecha(sort: Desc)])
  @@index([edificio])
  @@index([tipo])
  @@index([producto_id])
  @@index([solicitante_id])
  @@map("movimientos")
}

// 6. Modelo de Auditoría (Bitácora de Seguridad)
model Auditoria {
  id               Int      @id @default(autoincrement())
  usuario_id       Int      
  accion           String   @db.VarChar(100) 
  entidad          String   @db.VarChar(50)  
  entidad_id       Int?     
  detalles         String?  @db.Text         
  fecha            DateTime @default(now()) 

  usuario          Usuario  @relation(fields: [usuario_id], references: [id], onDelete: Restrict)

  //  ÍNDICES DE RENDIMIENTO (Crucial para revisar logs grandes)
  @@index([fecha(sort: Desc)])
  @@index([usuario_id])
  @@index([entidad])
  @@map("auditoria")
}

// 7. Control de inventario por edificio 
model StockEdificio {
  id           Int      @id @default(autoincrement())
  producto_id  Int
  edificio     String   @db.VarChar(50) 
  stock_actual Decimal  @default(0.00) @db.Decimal(10, 2)
  stock_minimo Decimal  @default(0.00) @db.Decimal(10, 2)

  producto     Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([producto_id, edificio]) 
  //  ÍNDICES DE RENDIMIENTO
  @@index([edificio])
  @@index([producto_id])
  @@map("stock_edificio")  
}

// 8. Registro Histórico de Desabasto 
model HistorialStockCritico {
  id          Int      @id @default(autoincrement())
  producto_id Int
  edificio    String   @db.VarChar(50)
  stock_visto Decimal  @db.Decimal(10, 2)
  stock_min   Decimal  @db.Decimal(10, 2)
  fecha       DateTime @default(now())

  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  //  ÍNDICES DE RENDIMIENTO
  @@index([fecha(sort: Desc)])
  @@index([edificio])
  @@map("historial_stock_critico")
}